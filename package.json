{
  "name": "pnnh-hospital-website",
  "version": "0.1.0",
  "private": true,
  "description": "Repo-level orchestration scripts. App code lives in frontend/ and backend/.",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix frontend run start",
    "lint": "npm --prefix frontend run lint",
    "docker:up": "docker compose --env-file .env.docker up -d --build",
    "docker:down": "docker compose --env-file .env.docker down",
    "docker:logs": "docker compose --env-file .env.docker logs -f",
    "docker:reset-db": "docker compose --env-file .env.docker down -v",
    "docker:tools:up": "docker compose --env-file .env.docker --profile tools up -d phpmyadmin",
    "docker:prod:up": "docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml --env-file .env.production down",
    "docker:prod:logs": "docker compose -f docker-compose.prod.yml --env-file .env.production logs -f"
  }
}
