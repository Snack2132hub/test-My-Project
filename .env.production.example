DB_HOST=your-db-host
DB_PORT=3306
DB_NAME=your-db-name
DB_USER=your-db-user
DB_PASSWORD=your-db-password

NEXT_PUBLIC_SHOW_DB_TEST=false
ENABLE_DB_DEBUG_ENDPOINT=false

# Admin login (/admin) — generate a long random value for ADMIN_SESSION_SECRET,
# e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=your-admin-password
ADMIN_SESSION_SECRET=your-random-secret