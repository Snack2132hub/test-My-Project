# Copy this file to .env.local for local development outside Docker
# (Next.js loads .env.local automatically; this file itself is not read).

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pnnh_docker
DB_USER=root
DB_PASSWORD=

NEXT_PUBLIC_SHOW_DB_TEST=true
ENABLE_DB_DEBUG_ENDPOINT=true

ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123
ADMIN_SESSION_SECRET=replace-with-a-long-random-string
